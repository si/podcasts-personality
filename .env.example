# Server port (Railway/Render inject this automatically)
PORT=5000

# Set to "production" when deploying
NODE_ENV=development

# Comma-separated list of allowed CORS origins (production only).
# Leave unset when frontend is served from the same origin (recommended).
# ALLOWED_ORIGINS=https://your-app.up.railway.app

# PostgreSQL connection string. Railway injects this automatically when a Postgres
# service is added to the project. Required for the app to start.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Anthropic API key for AI personality analysis (optional).
# Without this the category/frequency stats still display; the AI section is skipped.
# ANTHROPIC_API_KEY=sk-ant-...

# Spotify OAuth credentials (optional — enables "Connect with Spotify" import).
# Register your app at https://developer.spotify.com/dashboard and add the redirect URI below.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:5000/auth/spotify/callback
# Note: SPOTIFY_REDIRECT_URI must exactly match what is registered in the Spotify Developer Dashboard.
# For production use your full domain, e.g. https://yourapp.com/auth/spotify/callback

# Frontend origin used to redirect users back after OAuth (development only).
# In production the app is served from the same origin so this can be left unset.
# FRONTEND_URL=http://localhost:3000
